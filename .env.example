# ============================================================
# Library Marocain — Variables d'environnement
# ============================================================
# Ce fichier est un MODELE. Copie-le en `.env` (local) et/ou
# configure les memes cles dans Vercel > Settings > Environment
# Variables. NE JAMAIS COMMITTER le vrai `.env`.

# ---------- Serveur ----------
PORT=3001
NODE_ENV=production
# Sur Vercel cette variable est definie automatiquement (VERCEL=1)

# ---------- Base de données ----------
# Option A (dev local) : connexion directe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=librairie_marocaine
DB_USER=postgres
DB_PASSWORD=

# Option B (Vercel Postgres / Neon / Supabase) : URL de connexion
# Le backend utilise POSTGRES_URL s'il existe (prioritaire sur DB_*).
# POSTGRES_URL = version POOLEE (a utiliser dans l'application)
# POSTGRES_URL_NON_POOLING = version directe (pour les migrations)
POSTGRES_URL=
# DATABASE_URL=          # alternative courante (meme format)
# POSTGRES_URL_NON_POOLING=

# ---------- Sécurité ----------
# Secret JWT : OBLIGATOIRE, min 32 caracteres, aleatoire.
# Genere un avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origines autorisees pour CORS (separees par une virgule).
# Laisser vide en dev. En prod : https://ton-app.vercel.app
CORS_ORIGIN=

# URL du frontend utilisee dans les emails (lien reset password)
FRONTEND_URL=https://ton-app.vercel.app

# ---------- Email (Brevo) ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Library Marocain

# ---------- Stockage (Vercel Blob) ----------
# Fourni automatiquement par Vercel si Blob est active sur le projet.
# S'il est absent, le backend ecrit les fichiers sur disque (dev local).
BLOB_READ_WRITE_TOKEN=
